---
import TerminalWindow from './TerminalWindow.astro';

const email = 'niharchinta333@gmail.com';
const location = 'Houston, USA';
---

<TerminalWindow title="~/contact.sh" id="contact">
  <div class="intro">
    <h2>Let's <span class="accent">Connect</span></h2>
    <p class="text-muted">
      Always open to connecting, sharing ideas, and exploring roles or projects that push the
      boundaries of what technology can do.
    </p>
  </div>

  <div class="grid">
    <div class="info-cards">
      <div class="info-card">
        <h3>Email</h3>
        <p class="text-muted">Always happy to chat</p>
        <a href={`mailto:${email}`}>{email}</a>
      </div>
      <div class="info-card">
        <h3>Location</h3>
        <p class="text-muted">{location}</p>
      </div>
    </div>

    <form id="contact-form" class="contact-form">
      <h3>Send a Message</h3>
      <label for="contact-name">Name</label>
      <input id="contact-name" name="name" type="text" placeholder="Your name" required />

      <label for="contact-message">Message</label>
      <textarea
        id="contact-message"
        name="message"
        rows="5"
        placeholder="Tell me about your project, idea, or just say hi!"
        required
      ></textarea>

      <button type="submit" class="btn btn-accent">[ Send Message ]</button>
    </form>
  </div>
</TerminalWindow>

<script define:vars={{ email }}>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = form.name.value;
    const message = form.message.value;
    const subject = encodeURIComponent(`Message from ${name}`);
    const body = encodeURIComponent(message);
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>

<style>
  .intro {
    text-align: center;
    margin-bottom: 2rem;
  }

  .accent {
    color: var(--accent-green);
  }

  .intro h2 {
    font-size: 1.8rem;
  }

  .intro p {
    max-width: 560px;
    margin: 0.5rem auto 0;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .info-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-card {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    background: var(--panel);
  }

  .info-card h3 {
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .info-card p {
    margin: 0 0 0.35rem;
  }

  .contact-form {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.25rem;
    background: var(--panel);
    display: flex;
    flex-direction: column;
  }

  .contact-form h3 {
    margin-bottom: 1rem;
  }

  .contact-form label {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.3rem;
  }

  .contact-form input,
  .contact-form textarea {
    font-family: inherit;
    font-size: 0.9rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text);
    padding: 0.55em 0.7em;
    margin-bottom: 1rem;
    resize: vertical;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--accent-blue);
  }

  .contact-form button {
    align-self: flex-start;
  }
</style>

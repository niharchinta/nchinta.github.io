---
import { SHOW_PROJECTS } from '../data/projects';

const links = [
  { href: '/#experience', label: 'experience' },
  { href: '/#skills', label: 'skills' },
  ...(SHOW_PROJECTS ? [{ href: '/#projects', label: 'projects' }] : []),
  { href: '/#hobbies', label: 'hobbies' },
  { href: '/cv', label: 'cv' },
];
---

<nav class="nav">
  <div class="container nav-inner">
    <a class="brand" href="/">nihar@portfolio<span class="text-muted">:~$</span></a>
    <ul class="links">
      {links.map((link) => (
        <li><a href={link.href}>--{link.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }

  .brand {
    color: var(--text);
    font-weight: 700;
    white-space: nowrap;
  }

  .brand:hover {
    text-decoration: none;
    color: var(--accent-green);
  }

  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
  }

  .links a {
    color: var(--text-muted);
  }

  .links a:hover {
    color: var(--accent-green);
    text-decoration: none;
  }
</style>
